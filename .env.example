# WhatsApp Cloud API (Meta for Developers)
# https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_PHONE_ID=     # ID do número de telefone do negócio
WHATSAPP_TOKEN=        # Token de acesso permanente ou temporário

# Número do destinatário: código do país + DDD + número, sem + ou espaços
# Exemplo Brasil: 5511999999999
